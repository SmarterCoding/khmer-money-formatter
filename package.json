{
    "name": "khmer-money-formatter",
    "version": "1.0.4",
    "description": "Lightweight, dependency-free TypeScript library for formatting, parsing, and converting Khmer Riel and Khmer numbers.",
    "keywords": [
        "khmer",
        "khmer-money",
        "khmer-number",
        "khmer-currency",
        "riel",
        "khr",
        "currency",
        "money",
        "formatter",
        "number-formatter",
        "typescript",
        "javascript",
        "cambodia"
    ],
    "homepage": "https://github.com/SmarterCoding/khmer-money-formatter",
    "bugs": {
        "url": "https://github.com/SmarterCoding/khmer-money-formatter/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SmarterCoding/khmer-money-formatter.git"
    },
    "license": "MIT",
    "author": "Chamnan (https://github.com/SmarterCoding)",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "directories": {
        "test": "tests"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "SECURITY.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm test",
        "prepublishOnly": "npm run check && npm run build"
    },
